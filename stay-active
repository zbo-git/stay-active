#!/bin/bash
# stay-active - macOS synthetic activity utility (MIT)
VERSION="1.1.0"
SELF="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
STATE_DIR="${STAY_ACTIVE_STATE_DIR:-$HOME/.local}"
PID_FILE="$STATE_DIR/.stay_active_pid"
LOCK_DIR="$STATE_DIR/.stay_active_lock"
LOG_FILE="$STATE_DIR/.stay_active_log"
PLIST="$HOME/Library/LaunchAgents/net.zbo.stay-active.plist"
MIN_IDLE="${STAY_ACTIVE_MIN_IDLE_SECONDS:-60}"
MOUSE="${STAY_ACTIVE_MOUSE:-0}"

log_msg() {
    mkdir -p "$STATE_DIR"
    printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

valid_config() {
    [[ "$MIN_IDLE" =~ ^[0-9]+$ ]] || { echo 'STAY_ACTIVE_MIN_IDLE_SECONDS must be a nonnegative integer' >&2; return 1; }
    [[ "$MOUSE" = 0 || "$MOUSE" = 1 ]] || { echo 'STAY_ACTIVE_MOUSE must be 0 or 1' >&2; return 1; }
}

# Only signal processes whose command line matches this specific executable in worker mode.
# Refuse uncertain ownership rather than risk killing an unrelated process.
worker_alive() {
    local pid command_line
    [[ -f "$PID_FILE" ]] || return 1
    pid=$(cat "$PID_FILE" 2>/dev/null) || return 1
    [[ "$pid" =~ ^[0-9]+$ ]] && ((pid > 1)) || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    command_line=$(ps -p "$pid" -o command= 2>/dev/null) || return 1
    [[ "$command_line" == *"$SELF"* && "$command_line" == *"__run"* ]]
}

cleanup() {
    local current
    current=$(cat "$PID_FILE" 2>/dev/null) || return 0
    if [[ "$current" = "$$" ]]; then
        rm -f "$PID_FILE"
        rmdir "$LOCK_DIR" 2>/dev/null || true
    fi
}

check_dependencies() {
    command -v cliclick >/dev/null 2>&1 || { echo 'Missing cliclick; install with brew install cliclick' >&2; return 1; }
    command -v ioreg >/dev/null 2>&1 || { echo 'ioreg not found: this utility requires macOS' >&2; return 1; }
}

read_idle_seconds() {
    local nanos
    nanos=$(ioreg -c IOHIDSystem 2>/dev/null | awk -F'= ' '/"HIDIdleTime"/ {print $2; exit}')
    [[ "$nanos" =~ ^[0-9]+$ ]] || return 1
    echo $((nanos / 1000000000))
}

simulate_activity() {
    local position x y
    if [[ "$MOUSE" = 1 ]]; then
        position=$(cliclick p 2>/dev/null) || return 1
        [[ "$position" =~ ^[0-9]+,[0-9]+$ ]] || return 1
        x=${position%,*}; y=${position#*,}
        x=$((x + RANDOM % 11 - 5)); y=$((y + RANDOM % 11 - 5))
        ((x >= 0)) || x=0
        ((y >= 0)) || y=0
        cliclick -e 30 "m:$x,$y" >/dev/null 2>&1 || return 1
    fi
    cliclick kd:shift ku:shift >/dev/null 2>&1 || return 1
    log_msg "Synthetic input sent (mouse=$MOUSE); application presence not verified"
}

run_worker() {
    local idle failures=0 interval i
    trap 'exit 0' INT TERM HUP
    trap cleanup EXIT
    check_dependencies || exit 1
    valid_config || exit 1
    log_msg "Worker started (v$VERSION; min idle $MIN_IDLE sec; mouse=$MOUSE)"
    while :; do
        idle=$(read_idle_seconds) || { log_msg 'ERROR: unable to inspect system idle time; exiting'; exit 1; }
        if ((idle >= MIN_IDLE)); then
            if simulate_activity; then
                failures=0
            else
                failures=$((failures + 1))
                log_msg "ERROR: cliclick failed ($failures/3); check Accessibility permissions"
                if ((failures >= 3)); then exit 1; fi
            fi
        else
            log_msg "Skipped input: recent system activity ($idle sec idle)"
        fi
        interval=$((30 + RANDOM % 31))
        for ((i=0; i<interval; i++)); do sleep 1; done
    done
}

start_worker() {
    local pid
    check_dependencies || return 1
    valid_config || return 1
    mkdir -p "$STATE_DIR"
    if ! mkdir "$LOCK_DIR" 2>/dev/null; then
        if worker_alive; then echo "Already running (PID $(cat "$PID_FILE"))"; return 0; fi
        echo "Unverified or stale lock at $LOCK_DIR; inspect before manually removing lock and PID file" >&2
        return 1
    fi
    nohup /bin/bash "$SELF" __run </dev/null >> "$LOG_FILE" 2>&1 &
    pid=$!
    printf '%s\n' "$pid" > "$PID_FILE"
    echo "Started (PID $pid)"
}

stop_worker() {
    local pid
    if ! worker_alive; then echo 'Not running; no process was signaled' >&2; return 1; fi
    pid=$(cat "$PID_FILE")
    kill "$pid" && echo "Stop requested (PID $pid)"
}

status_worker() {
    if worker_alive; then echo "Running (PID $(cat "$PID_FILE"))"; return 0; fi
    if [[ -d "$LOCK_DIR" ]]; then echo 'Stopped (stale or unverified lock)'; else echo 'Stopped'; fi
    return 1
}

install_agent() {
    # LaunchAgent points to the installed script; avoids depending on the shell PATH.
    local installed="$HOME/.local/bin/stay-active"
    [[ -f "$installed" ]] || { echo "Install $installed first" >&2; return 1; }
    case "$installed" in *'&'*|*'<'*|*'>'*|*'"'*) echo 'Unsupported character in home path' >&2; return 1;; esac
    mkdir -p "$(dirname "$PLIST")"
    cat > "$PLIST" <<XML
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>Label</key><string>net.zbo.stay-active</string>
<key>ProgramArguments</key><array><string>/bin/bash</string><string>$installed</string><string>start</string></array>
<key>RunAtLoad</key><true/>
<key>StartInterval</key><integer>60</integer>
</dict></plist>
XML
    launchctl unload "$PLIST" >/dev/null 2>&1 || true
    launchctl load "$PLIST"
}

remove_agent() {
    launchctl unload "$PLIST" >/dev/null 2>&1 || true
    rm -f "$PLIST"
    echo 'Login LaunchAgent removed'
}

case "${1:-}" in
    start) start_worker ;;
    stop) stop_worker ;;
    toggle) if worker_alive; then stop_worker; else start_worker; fi ;;
    status) status_worker ;;
    log) if [[ -f "$LOG_FILE" ]]; then tail -20 "$LOG_FILE"; else echo 'No activity log yet'; fi ;;
    autostart-on) install_agent ;;
    autostart-off) remove_agent ;;
    __run) run_worker ;;
    -v|--version) echo "stay-active v$VERSION" ;;
    -h|--help|help|"")
        cat <<HELP
stay-active v$VERSION (macOS)
Commands: start, stop, toggle, status, log, autostart-on, autostart-off
Settings: STAY_ACTIVE_MIN_IDLE_SECONDS=60; STAY_ACTIVE_MOUSE=0 (0 disables cursor movement)
Synthetic input may not change application presence; verify independently.
HELP
        ;;
    *) echo "Unknown command: $1" >&2; exit 2 ;;
esac
